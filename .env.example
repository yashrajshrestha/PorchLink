# Copy to .env and fill in. Never commit .env.

# Ring: Playground token (valid 30 min), or RING_FAKE=1 for local test mode
RING_TOKEN=
RING_FAKE=0
# Ring webhooks: the HMAC signing key from your Ring app credentials. Webhooks are refused (503) until it is set.
# The local simulator signs with "sim-secret" unless you pass --webhook-secret. It reads RING_WEBHOOK_SECRET from
# the shell environment, not from .env, so export it (or pass --webhook-secret) when using a real one.
RING_WEBHOOK_SECRET=
# 1 prints each verified webhook body (useful for capturing Ring's real payload). Refused webhooks never print theirs.
# WEBHOOK_LOG=0

# Email alerts (Gmail: smtp.gmail.com, port 587, use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# Rules
ALERT_TZ=Asia/Kathmandu
NIGHT_START=23
NIGHT_END=6
BURST_COUNT=3
BURST_MINUTES=30
ALERT_EVERY_EVENT=1

# Snapshot descriptions: VISION=bedrock (AWS, needs .venv with requirements-v2.txt and YOUR OWN account),
# VISION=ollama (open-source model on this machine), or empty for none. BEDROCK_ENABLED=1 still means bedrock.
VISION=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
BEDROCK_ENABLED=0
AWS_PROFILE=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

POLL_SECONDS=10
WEB_PORT=8080

# Home actions: local virtual devices, mqtt (open-source broker such as Mosquitto), or iot (AWS IoT Core, your own account)
BRIDGE=local
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
IOT_REGION=us-east-1
AUTOMATIONS_PATH=

# Strands Decider: a local decision model that reads the camera description and says what is at the door
# (package / person / vehicle / animal / nothing). Start the server first (see README). Off = keyword matching.
DECIDER_ENABLED=0
DECIDER_URL=http://127.0.0.1:8000
DECIDER_MIN_P=0.5
DECIDER_TIMEOUT=30
